<Window x:Class="WindowsEasyEmoji.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Easy Emoji 설정"
        Width="460"
        Height="464"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="설정" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="단축키와 붙여넣기 동작을 관리합니다."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <CheckBox x:Name="ReplaceWinPeriodCheckBox"
                          Content="Win + . 대체"
                          FontSize="14"
                          Margin="0,0,0,14" />

                <CheckBox x:Name="FallbackHotkeyEnabledCheckBox"
                          Content="Fallback hotkey 사용"
                          FontSize="14"
                          Margin="0,0,0,8"
                          Checked="FallbackHotkeyEnabledCheckBox_Changed"
                          Unchecked="FallbackHotkeyEnabledCheckBox_Changed" />

                <Grid Margin="22,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hotkey"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,10,0" />
                    <TextBox x:Name="FallbackHotkeyTextBox"
                             Grid.Column="1"
                             Height="32"
                             Padding="8,4"
                             Background="{StaticResource PanelBrush}"
                             BorderBrush="#52525B"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}" />
                </Grid>

                <CheckBox x:Name="AutoPasteCheckBox"
                          Content="선택한 이모지를 원래 입력창에 자동 붙여넣기"
                          FontSize="14"
                          Margin="0,0,0,14"
                          Checked="AutoPasteCheckBox_Changed"
                          Unchecked="AutoPasteCheckBox_Changed" />

                <CheckBox x:Name="RestoreClipboardCheckBox"
                          Content="붙여넣기 후 기존 클립보드 복원"
                          FontSize="14"
                          Margin="0,0,0,18" />

                <Button Content="설정 파일 열기"
                        Width="132"
                        HorizontalAlignment="Left"
                        Padding="10,6"
                        Click="OpenSettingsFileButton_Click" />

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="앱 정보"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="InfoText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Foreground="#FCA5A5"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <Button Content="기본값"
                        DockPanel.Dock="Left"
                        Width="82"
                        Padding="10,7"
                        Click="ResetButton_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소"
                            Width="76"
                            Padding="10,7"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click" />
                    <Button Content="저장"
                            Width="76"
                            Padding="10,7"
                            Click="SaveButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
