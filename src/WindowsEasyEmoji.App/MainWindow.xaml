<Window x:Class="WindowsEasyEmoji.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Easy Emoji"
        Width="420"
        Height="580"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" Background="#052E16" CornerRadius="8" Padding="8,5">
                    <TextBlock Text="● Win + ." Foreground="#86EFAC" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="Windows Easy Emoji" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#52525B" BorderThickness="1" CornerRadius="8" Height="54">
                <DockPanel Margin="14,0">
                    <TextBlock Text="⌕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             FontSize="24"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="한국어 · 영어 · 초성 · 별칭 · shortcode 검색"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="2,12,0,12" />

            <Grid Grid.Row="3">
                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         SelectionMode="Single"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding FavoriteMarker}"
                                               Foreground="#FDE68A"
                                               FontSize="16"
                                               Width="24"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Record.Emoji}"
                                               Style="{StaticResource EmojiTextBlockStyle}"
                                               FontSize="32"
                                               Width="48"
                                               VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Record.Name.Ko}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MatchType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="NoResultsPanel"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="검색 결과 없음"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="일치하는 이모지가 없습니다"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Row="4" Margin="2,12,0,0">
                <TextBlock x:Name="PasteStatusText" DockPanel.Dock="Right" Foreground="#86EFAC" FontSize="12" />
                <TextBlock Text="↑↓ 이동   Enter 붙여넣기   Esc 닫기" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
