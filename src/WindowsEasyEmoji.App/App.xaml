<Application x:Class="WindowsEasyEmoji.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#27272A" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    </Application.Resources>
</Application>
